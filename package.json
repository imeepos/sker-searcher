{
  "name": "sker-searcher",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "npx turbo clean && rm -rf node_modules && pnpm -r exec rm -rf node_modules && pnpm -r exec rm -rf .wrangler",
    "rebase": "git fetch origin master && git rebase origin/master",
    "deploy:web": "turbo run deploy --filter=bowong-web",
    "deploy:admin": "turbo run deploy --filter=bowong-admin",
    "deploy:gateway": "turbo run deploy --filter=bowong-gateway"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "0.25.2",
    "prettier": "^3.2.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "wrangler": "^4.13.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}