{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "globalEnv": [],
    "tasks": {
        "deploy": {
            "dependsOn": [
                "^build"
            ],
            "cache": false
        },
        "test": {
            "dependsOn": [
                "^build"
            ],
            "cache": false
        },
        "build": {
            "dependsOn": [
                "^build"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "check-types": {
            "dependsOn": [
                "^check-types"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "dependsOn": [
                "^build"
            ]
        },
        "clean": {
            "cache": false
        }
    }
}